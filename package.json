{
  "name": "n8n-nodes-seomatic",
  "version": "2.0.1",
  "description": "SEOmatic for n8n: Google Search Console insights, site audits, AI visibility, pay-as-you-go articles, and approval-gated SEO agent tasks, plus a trigger for SEOmatic events.",
  "keywords": [
    "n8n-community-node-package",
    "seo",
    "seomatic",
    "search console",
    "ai visibility",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://seomatic.ai/developers",
  "author": {
    "name": "SEOmatic",
    "email": "contact@seomatic.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minh42/n8n-nodes-seomatic.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node test/node-tests.cjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SeomaticApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Seomatic/Seomatic.node.js",
      "dist/nodes/SeomaticTrigger/SeomaticTrigger.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
